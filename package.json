{
  "name": "spreadle-ai-commit-gen",
  "displayName": "AI Commit Gen",
  "description": "Generate conventional commit messages using multiple AI providers (OpenAI, Claude, Gemini, Groq, z.ai)",
  "version": "0.1.0",
  "publisher": "spreadle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theadhithyankr/auto-commit-message-generator.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Source Control",
    "Other"
  ],
  "keywords": [
    "ai",
    "commit",
    "git",
    "conventional commits",
    "source control"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiCommitGen.generate",
    "onCommand:aiCommitGen.switchProvider",
    "onCommand:aiCommitGen.setApiKey"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCommitGen.generate",
        "category": "AI Commit Gen",
        "title": "AI Commit Gen: Generate Message",
        "icon": {
          "light": "media/commit-gen.svg",
          "dark": "media/commit-gen.svg"
        }
      },
      {
        "command": "aiCommitGen.generating",
        "category": "AI Commit Gen",
        "title": "AI Commit Gen: Generating...",
        "icon": "$(loading~spin)",
        "enablement": "false"
      },
      {
        "command": "aiCommitGen.switchProvider",
        "category": "AI Commit Gen",
        "title": "AI Commit Gen: Switch Provider"
      },
      {
        "command": "aiCommitGen.setApiKey",
        "category": "AI Commit Gen",
        "title": "AI Commit Gen: Set API Key"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommitGen.generate",
          "group": "navigation@1",
          "when": "scmProvider == git && !aiCommitGen.generating"
        },
        {
          "command": "aiCommitGen.generating",
          "group": "navigation@1",
          "when": "scmProvider == git && aiCommitGen.generating"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Gen",
      "properties": {
        "aiCommitGen.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "groq",
            "zai"
          ],
          "default": "openai",
          "description": "AI provider to use for generating commit messages"
        },
        "aiCommitGen.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model to use"
        },
        "aiCommitGen.anthropic.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "Anthropic model to use"
        },
        "aiCommitGen.gemini.model": {
          "type": "string",
          "default": "gemini-2.0-flash",
          "description": "Google Gemini model to use"
        },
        "aiCommitGen.groq.model": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "Groq model to use"
        },
        "aiCommitGen.zai.model": {
          "type": "string",
          "default": "glm-4-flash",
          "description": "z.ai (Zhipu) model to use"
        },
        "aiCommitGen.maxDiffSize": {
          "type": "number",
          "default": 10000,
          "description": "Max diff size in characters to send to the AI"
        },
        "aiCommitGen.autoStage": {
          "type": "boolean",
          "default": true,
          "description": "Automatically stage all unstaged and untracked changes before generating a commit message when nothing is staged"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package:bundle",
    "check-types": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.mjs",
    "package:bundle": "npm run check-types && node esbuild.mjs --production",
    "compile": "npm run check-types && npm run bundle",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^4.70.0"
  }
}
